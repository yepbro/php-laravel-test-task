# --- Приложение ---
APP_NAME="MarketHub Orders"
APP_ENV=local
APP_KEY=
# В прод-окружении всегда false: стектрейсы и отладка наружу не отдаются (NFR-04)
APP_DEBUG=false
APP_URL=http://localhost
# Часовой пояс приложения; доменные даты хранятся и считаются в UTC (NFR-03)
APP_TIMEZONE=UTC
# Порт приложения на хосте (Sail)
APP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Уровень логов по §5.4 ТЗ (локально можно поднять до debug)
LOG_LEVEL=info

FILESYSTEM_DISK=local

# --- Сидирование демо-данных (локальная разработка) ---
# Сколько демо-заказов создаёт DemoOrdersSeeder (sail artisan db:seed);
# сидер полностью пересоздаёт доменные таблицы, в production не запускается.
# Минимум 5 (покрытие всех статусов); больше — крупнее выборка для пагинации.
SEED_DEMO_ORDERS=30

# --- База данных (MySQL 8.4) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=markethub
DB_USERNAME=sail
DB_PASSWORD=password
# Порт MySQL на хосте (Sail)
FORWARD_DB_PORT=3306
# Дополнительные опции mysqld для контейнера MySQL (Sail); обычно пусто
MYSQL_EXTRA_OPTIONS=

# --- Кэш, сессии и очередь (Redis 7) ---
CACHE_STORE=redis
# CACHE_PREFIX=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Порт Redis на хосте (Sail)
FORWARD_REDIS_PORT=6379

# --- Почта (Mailpit) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Отправитель писем покупателю (Q27: no-reply@shop.local / «Магазин»)
MAIL_FROM_ADDRESS="no-reply@shop.local"
MAIL_FROM_NAME="Магазин"
# Предел ожидания SMTP-ответа, секунды (должен быть меньше MARKETPLACE_ORDER_LOCK_LEASE)
MAIL_TIMEOUT=5
# Порт SMTP Mailpit на хосте (Sail)
FORWARD_MAILPIT_PORT=1025
# Порт веб-интерфейса Mailpit на хосте (Sail)
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# --- Вебхуки MarketHub ---
# Секрет подписи вебхуков; пустое значение — все вебхуки отклоняются (fail closed)
MARKETPLACE_WEBHOOK_SECRET=whsec_test_5f1d8c2a9b
# Допустимое отклонение X-Webhook-Timestamp, секунды (в обе стороны)
MARKETPLACE_WEBHOOK_TOLERANCE=300
# Ожидание блокировки заказа order:{id}, секунды
MARKETPLACE_ORDER_LOCK_TIMEOUT=3
# Срок владения блокировкой заказа, секунды (должен превышать MAIL_TIMEOUT)
MARKETPLACE_ORDER_LOCK_LEASE=15
# Срок хранения сырых тел событий вебхуков, дней
MARKETPLACE_EVENTS_RETENTION_DAYS=90

# --- Письма покупателю ---
# Максимум попыток отправки одного письма
NOTIFICATIONS_TRIES=5
# Порог перестановки зависших pending-уведомлений планировщиком, секунды
NOTIFICATIONS_SWEEP_AFTER_SECONDS=120
# Срок возврата средств в тексте письма об отмене оплаченного заказа, дней
NOTIFICATIONS_REFUND_DAYS=10

# --- Sail / контейнеры ---
# Пользователь внутри контейнеров (uid/gid пользователя хоста)
WWWUSER=1000
WWWGROUP=1000
# Режим Xdebug в контейнере (Sail)
SAIL_XDEBUG_MODE=off
# Адрес хоста для отладчика Xdebug (Sail)
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal
# Число воркеров встроенного PHP-сервера (параллельные вебхуки, R-5)
PHP_CLI_SERVER_WORKERS=4

# --- Фронтенд (Vite) ---
VITE_APP_NAME="${APP_NAME}"
# Порт Vite dev-сервера на хосте (Sail, горячая перезагрузка)
VITE_PORT=5173

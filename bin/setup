#!/usr/bin/env bash
#
# Чистый запуск проекта одной командой (T-042, §5.2 ТЗ).
#
#   ./bin/setup
#
# Что делает:
#   1. .env — из .env.example (если ещё нет);
#   2. composer install — хостовым Composer (нужен PHP >= 8.5) или
#      в контейнере laravelsail/php84-composer (образа php85-composer
#      не существует, поэтому с --ignore-platform-reqs: платформенную
#      проверку делает сам рантайм sail-8.5);
#   3. ./vendor/bin/sail up -d --build.
#
# Дальше стартовый процесс laravel.test сам идемпотентно сгенерирует
# APP_KEY, применит миграции и соберёт фронтенд (первая сборка — npm ci
# + npm run build — занимает несколько минут; очередь Horizon и
# scheduler стартуют после его healthcheck GET /up). Подробности —
# bin/start-container.

set -euo pipefail

cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
    echo '>> .env не найден — копирую .env.example' >&2
    cp .env.example .env
    # Значения по умолчанию из .env.example (WWWUSER/WWWGROUP=1000) —
    # для типового uid/gid хоста. На хосте с другим uid/gid контейнер
    # не сможет писать в файлы проекта (sail source-ит .env и
    # экспортирует именно эти значения), поэтому свежий .env
    # приводим к фактическому пользователю хоста. sed -i.bak —
    # переносимо между GNU и BSD (macOS) sed.
    sed -i.bak \
        -e "s/^WWWUSER=.*/WWWUSER=$(id -u)/" \
        -e "s/^WWWGROUP=.*/WWWGROUP=$(id -g)/" \
        .env
    rm -f .env.bak
fi

# --- Preflight: занятость портов стека (до долгой установки) ---------------
# Порты, которые опубликует compose (compose.yaml + фактические значения
# из .env). Проверяем ДО composer install/сборки образа, чтобы конфликт
# выяснялся за секунды, а не после минут установки. Порты, занятые
# контейнерами ЭТОГО проекта (label working_dir), конфликтом не считаются:
# работающий стек sail up просто пересоздаст.
check_ports() {
    command -v docker >/dev/null 2>&1 || {
        echo '!! docker не найден — проверку портов пропускаю' >&2
        return 0
    }

    env_value() { # KEY DEFAULT — последнее вхождение KEY= из .env без кавычек
        local v
        v="$(grep -E "^$1=" .env 2>/dev/null | tail -n1 | cut -d= -f2-)"
        v="${v%\"}"; v="${v#\"}"
        printf '%s' "${v:-$2}"
    }

    local our_ports foreign_ports listener conflicts=''
    our_ports="$(docker ps --filter "label=com.docker.compose.project.working_dir=$PWD" \
        --format '{{.Ports}}' 2>/dev/null)"
    foreign_ports="$(docker ps --format '{{.Names}} {{.Ports}}' 2>/dev/null | grep -v '^$')"

    local spec="APP_PORT:80 VITE_PORT:5173 FORWARD_DB_PORT:3306 FORWARD_REDIS_PORT:6379 FORWARD_MAILPIT_PORT:1025 FORWARD_MAILPIT_DASHBOARD_PORT:8025"
    for entry in $spec; do
        local var="${entry%%:*}" default="${entry##*:}"
        local port; port="$(env_value "$var" "$default")"
        case "$port" in ''|*[!0-9]*) continue ;; esac

        # 1. Свой контейнер уже публикует порт — не конфликт.
        if printf '%s' "$our_ports" | grep -qE "[:.]$port->"; then
            continue
        fi

        # 2. Чужой контейнер занял порт.
        local owner
        owner="$(printf '%s\n' "$foreign_ports" \
            | grep -E "[:.]$port->" | awk '{print $1}' | paste -sd, -)"
        if [ -n "$owner" ]; then
            conflicts="${conflicts}  порт $port занят контейнером(ами): $owner — поправьте $var в .env"$'\n'
            continue
        fi

        # 3. Хостовый слушатель (не docker-proxy — те учтены выше).
        if command -v ss >/dev/null 2>&1; then
            listener="$(ss -ltnpH "sport = :$port" 2>/dev/null \
                | grep -v '"docker-proxy' \
                | grep -oE 'users:\(\("[^"]+"' | head -n1 | sed 's/^users:((\"//;s/\"$//')"
            if [ -n "$listener" ]; then
                conflicts="${conflicts}  порт $port занят процессом $listener — поправьте $var в .env"$'\n'
            fi
        fi
    done

    if [ -n "$conflicts" ]; then
        echo '!! Порты стека заняты — sail up упадёт после установки. Конфликты:' >&2
        printf '%s' "$conflicts" >&2
        return 1
    fi
    echo '>> Порты стека свободны' >&2
}
check_ports || exit 1

if [ ! -f vendor/autoload.php ]; then
    # Проверка хостового PHP — по мажор.минор (констрейнт composer
    # "8.5.*"): PHP 8.6 не должен попадать в хостовую ветку.
    if command -v composer >/dev/null 2>&1 \
        && command -v php >/dev/null 2>&1 \
        && php -r 'exit(str_starts_with(PHP_VERSION, "8.5") ? 0 : 1);'; then
        echo ">> composer install (хостовой PHP $(php -r 'echo PHP_VERSION;'))" >&2
        composer install
    else
        echo '>> composer install в контейнере laravelsail/php84-composer (хостового PHP 8.5 нет)' >&2
        # COMPOSER_HOME — во временную директорию контейнера: в образе нет
        # преднастроенного каталога кэша, доступного непривилегированному
        # uid (/.composer не создаётся под -u host-uid).
        docker run --rm \
            -u "$(id -u):$(id -g)" \
            -v "$(pwd):/var/www/html" \
            -w /var/www/html \
            -e COMPOSER_HOME=/tmp/composer \
            laravelsail/php84-composer:latest \
            composer install --ignore-platform-reqs
    fi
fi

echo '>> sail up -d --build (первый запуск собирает образ и зависимости npm — это может занять несколько минут)' >&2
./vendor/bin/sail up -d --build

./vendor/bin/sail ps
